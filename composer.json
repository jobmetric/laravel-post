{
    "name": "jobmetric/laravel-post",
    "description": "This is a post management package for Laravel that you can use in your projects.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "jobmetric",
        "package",
        "post",
        "management"
    ],
    "homepage": "https://doc.jobmetric.net/package/laravel-post",
    "authors": [
        {
            "name": "Majid Mohammadian",
            "email": "majeedmohammadian@gmail.com",
            "homepage": "https://www.linkedin.com/in/majidmohammadian/",
            "role": "Full Stack Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": ">=9.19",
        "jobmetric/laravel-flow": "^2.4",
        "jobmetric/laravel-taxonomy": "^4.3",
        "jobmetric/laravel-translation": "^4.0.2",
        "jobmetric/laravel-metadata": "^4.0.3",
        "jobmetric/media": "^2.2.1",
        "jobmetric/laravel-url": "^3.0.1",
        "jobmetric/laravel-package-core": "^1.38.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.5|^11.5|^12.5"
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "JobMetric\\Post\\": "src/",
            "JobMetric\\Post\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JobMetric\\Post\\PostServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "support": {
        "issues": "https://github.com/jobmetric/laravel-post/issues",
        "forum": "https://twitter.com/jobmetric",
        "source": "https://github.com/jobmetric/laravel-post"
    }
}
